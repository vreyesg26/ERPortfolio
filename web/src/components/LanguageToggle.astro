---
import {otherLang, pathFor, type Lang} from '../lib/i18n'

interface Props {
  lang: Lang
  label: string
}

const {lang, label} = Astro.props
---

<a
  href={pathFor(otherLang(lang))}
  class="change-language"
  id="language-button"
  aria-label={label}
  title={label}
>
  <i class="ri-global-line"></i>
  <span id="language-code">{lang.toUpperCase()}</span>
</a>
