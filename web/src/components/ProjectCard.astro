---
import {imageUrl} from '../lib/image'
import type {PROJECTS_QUERY_RESULT} from '../sanity.types'

interface Props {
  project: PROJECTS_QUERY_RESULT[number]
  viewPlanLabel: string
}

const {project, viewPlanLabel} = Astro.props
---

<article class="projects__card">
  <img src={imageUrl(project.image, 600)} alt={project.alt} class="projects__img" />

  <div class="projects__modal">
    <div>
      <h3 class="projects__title">{project.title}</h3>
      <a
        href={project.driveUrl}
        class="projects__button button button__small"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={viewPlanLabel}
      >
        <i class="ri-eye-line"></i>
      </a>
    </div>
  </div>
</article>
