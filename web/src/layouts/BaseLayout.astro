---
import {ClientRouter} from 'astro:transitions'
import Seo from '../components/Seo.astro'
import type {Lang} from '../lib/i18n'
import {SEO_QUERY} from '../lib/queries'
import {client} from '../lib/sanity'
import 'remixicon/fonts/remixicon.css'
import '../styles/styles.scss'

interface Props {
  lang: Lang
}

const {lang} = Astro.props
const seo = await client.fetch(SEO_QUERY, {lang})
if (!seo) throw new Error('Falta el documento seo en Sanity')
// Tema antes del primer pintado: el parser se detiene en un script sin async, asi
// que el script inline del body corre antes de que se pinte nada. Es lo que elimina
// el parpadeo de tema claro al recargar en oscuro. Mismas claves que el sitio actual.
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo lang={lang} seo={seo} />
    <ClientRouter />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  </head>
  <body>
    <!-- data-astro-rerun: el ClientRouter reemplaza el body al navegar y se llevaria la clase dark-theme. -->
    <script is:inline data-astro-rerun>
      try {
        if (localStorage.getItem('selected-theme') === 'dark') {
          document.body.classList.add('dark-theme')
        }
      } catch (e) {}
    </script>
    <slot />
    <script>
      import {initScrollReveal} from '../lib/scrollReveal'

      // Solo en la carga inicial. Un script de modulo corre una vez, y el ClientRouter no lo
      // repite al navegar: cambiar de idioma no reanima el perfil (el sitio actual no anima
      // nada al cambiar de idioma). No usar astro:page-load, que si corre tras cada navegacion.
      initScrollReveal()
    </script>
  </body>
</html>
